{
	"name": "backend",
	"version": "1.0.0",
	"author": "adcimon",
	"type": "module",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
		"spec": "node --loader ts-node/esm scripts/spec.ts"
	},
	"dependencies": {
		"@aws-sdk/client-cognito-identity-provider": "^3.1154.0",
		"@nestjs/common": "^12.2.0",
		"@nestjs/core": "^12.2.0",
		"@nestjs/event-emitter": "^12.0.1",
		"@nestjs/platform-express": "^12.2.0",
		"@nestjs/swagger": "^12.0.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.8",
		"es-toolkit": "^1.52.0",
		"moment": "^2.31.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.10",
		"@nestjs/schematics": "^12.0.10",
		"@nestjs/testing": "^12.2.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.5",
		"jest": "^30.5.2",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.4.15",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	}
}
